+static unsigned long long get_arch_number(const uint8_t *b, int n, int little_endian)
+{
+    unsigned long long ret;
+    int shift;
+
+    if (!little_endian)
+        return get_be(b, n);
+
+    ret = 0;
+    shift = 0;
+    while (n > 0) {
+        ret |= (unsigned long long)(*b++) << shift;
+        shift += 8;
+        --n;
+    }
+    return ret;
+}
