+LIBTCCAPI int tcc_add_framework(TCCState *s, const char *framework_name)
+{
+    TCCState *s1 = s;
+#ifndef TCC_TARGET_MACHO
+    (void)framework_name;
+    return tcc_error_noabort("framework linking is only supported for Mach-O targets");
+#else
+    int i, ret;
+    char *path;
+
+    if (!framework_name || !*framework_name)
+        return tcc_error_noabort("missing framework name");
+
+    path = tcc_get_framework_dylib_path(s1, framework_name);
+    if (!path)
+        return tcc_error_noabort("framework '%s' not found", framework_name);
+
+    ret = tcc_add_file_internal(s1, path,
+            AFF_TYPE_LIB | AFF_REFERENCED_DLL | AFF_PRINT_ERROR);
+    tcc_free(path);
+    if (ret)
+        return ret;
+
+    for (i = 0; i < s1->nb_frameworks; ++i)
+        if (!strcmp(s1->frameworks[i], framework_name))
+            return 0;
+
+    dynarray_add(&s1->frameworks, &s1->nb_frameworks, tcc_strdup(framework_name));
+    return 0;
+#endif
+}
+
