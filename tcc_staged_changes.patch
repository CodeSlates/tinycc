+static int archive_symtab_entrysize(const char *name, int *little_endian,
+                                    int *ranlib_format) {
+  char trimmed[32];
+  size_t len = strlen(name);
+
+  *little_endian = 0;
+  *ranlib_format = 0;
+
+  if (len && name[len - 1] == '/')
+    --len;
+  if (len >= sizeof(trimmed))
+    len = sizeof(trimmed) - 1;
+  memcpy(trimmed, name, len);
+  trimmed[len] = '\0';
+
+  if (!strcmp(trimmed, "/"))
+    return 4;
+  if (!strcmp(trimmed, "/SYM64/"))
+    return 8;
+  if (!strncmp(trimmed, "__.SYMDEF", 9)) {
+    *little_endian = 1;
+    *ranlib_format = 1;
+    if (strstr(trimmed, "_64"))
+      return 16;
+    return 8;
+  }
+  return 0;
